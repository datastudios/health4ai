<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HealthKit read access -->
	<key>com.apple.developer.healthkit</key>
	<true/>

	<!-- Allows HKObserverQuery delivery while the app is backgrounded. Removed 2026-06 for an
	     iOS 27 Beta 1 _libxpc_initializer crash; restored 2026-09-14 on the public iOS 27 (D335). -->
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>

	<!-- com.apple.developer.healthkit.access (health-records) deliberately omitted: it requires
	     Apple review and the app reads no clinical records. Not part of the 2026-09-14 restore. -->

	<!-- Keychain sharing (optional: enables sharing with extensions) -->
	<!-- Remove this block if you don't need keychain sharing with an app extension -->
	<!-- <key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.healthkitbridge</string>
	</array> -->
</dict>
</plist>
