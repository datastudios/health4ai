---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeDetails from '../components/HomeDetails.astro';
import BrandLogo from '../components/BrandLogo.astro';
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<Layout>
<style is:global>
  .ecg-main   { stroke-dasharray: 950; stroke-dashoffset: 950; animation: ecg-draw 3.8s cubic-bezier(0.4,0,0.2,1) infinite; }
  .ecg-glow   { stroke-dasharray: 950; stroke-dashoffset: 950; animation: ecg-draw 3.8s cubic-bezier(0.4,0,0.2,1) infinite; }
  .ring-pulse { animation: ring-breathe 3.2s ease-in-out infinite; }
  .peak-dot   { animation: peak-pulse 3.8s ease-in-out infinite; transform-origin: 156px 138px; }
  .hp-field   { position:absolute; left:-9999px; top:-9999px; width:0; height:0; opacity:0; pointer-events:none; }
  .peak-halo  { animation: peak-pulse 3.8s ease-in-out infinite; animation-delay: 90ms; transform-origin: 156px 138px; }
  .card-a     { animation: float-up 4.8s ease-in-out infinite; }
  .card-b     { animation: float-up 4.8s ease-in-out infinite; animation-delay: 2.2s; }
  .cta-glow   { animation: glow-pulse 3s ease-in-out infinite; }
  .tab-btn { padding: 6px 18px; border-radius: 999px; font-size: 0.8rem; font-weight: 600; cursor: pointer; border: 1px solid rgba(255,45,120,0.2); background: transparent; color: var(--muted); transition: all 0.2s; }
  .tab-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .tab-btn:hover:not(.active) { border-color: var(--accent); color: #fff; }
  .code-block { background: #06070f; border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; padding: 20px 24px; font-family: ui-monospace,'SF Mono',monospace; font-size: 0.8rem; line-height: 1.7; color: #c8d0e8; overflow-x: auto; }
  .code-block .cm  { color: #4a5580; }
  .code-block .kw  { color: #ff6b9d; }
  .code-block .str { color: #a8d8a0; }
  .code-block .num { color: #ffc97a; }
  /* Focus indicators — WCAG 2.1 2.4.7 */
  .tab-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Waitlist forms. DOM order is email -> consent -> submit so that Tab and
     Return-to-submit both reach consent before the control that commits it.
     On sm+ the button is PAINTED back beside the field via explicit grid
     placement; grid placement is visual only and leaves tab order alone. */
  .wl-form { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 640px) {
    .wl-form { grid-template-columns: 1fr auto; }
    .wl-form .wl-email   { grid-column: 1; grid-row: 1; }
    .wl-form .wl-submit  { grid-column: 2; grid-row: 1; }
    .wl-form .wl-consent { grid-column: 1 / -1; grid-row: 2; }
  }
  .wl-form input:disabled, .wl-form button:disabled { opacity: .5; cursor: default; animation: none; }
  .wl-form:has(:disabled) .wl-consent { cursor: default; pointer-events: none; }
  input[type="email"]:focus-visible { box-shadow: 0 0 0 2px var(--accent) !important; border-color: var(--accent) !important; }
  @media (prefers-reduced-motion: reduce) {
    .ecg-main, .ecg-glow, .ring-pulse, .peak-dot, .peak-halo,
    .card-a, .card-b, .cta-glow, .animate-pulse { animation: none; }
    .ecg-main, .ecg-glow { stroke-dashoffset: 0; }
  }
</style>

<HomeHero />
<HomeDetails />

<!-- ── FOOTER CTA ──────────────────────────────────────────── -->
<section id="waitlist" class="px-6 py-24 text-center relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
    <div class="w-[600px] h-[300px] rounded-full opacity-[0.06]" style="background:radial-gradient(ellipse,#ff2d78 0%,transparent 70%)"></div>
  </div>
  <div class="relative max-w-lg mx-auto">
    <h2 class="text-3xl font-extrabold text-white tracking-tight mb-3">Get notified at launch</h2>
    <p class="text-sm mb-8" style="color:var(--muted)">One email when it's on the App Store. No spam, ever.</p>
    <form id="waitlist-form-2" class="wl-form max-w-md mx-auto">
      <input type="text" id="hp-2" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="email" id="email-input-2" placeholder="your@email.com" required
        class="wl-email rounded-xl px-4 py-3 text-white text-sm outline-none"
        style="background:#0f1225;border:1px solid rgba(255,255,255,0.1)" />
      <label for="tf-consent-2" class="wl-consent flex items-start gap-2 -mx-2 px-2 py-1.5 rounded-lg cursor-pointer text-left text-xs leading-relaxed transition-colors active:bg-white/5" style="color:var(--muted)">
        <input type="checkbox" id="tf-consent-2" class="mt-0.5 shrink-0 accent-[var(--accent)]" style="width:16px;height:16px" />
        <span>Also send me the TestFlight beta invite. Your email is <a href="/privacy#testflight" target="_blank" rel="noopener" class="underline hover:no-underline">shared with Apple<span class="sr-only"> (opens in a new tab)</span></a> to create the invitation.</span>
      </label>
      <button type="submit" class="wl-submit px-6 py-3 rounded-xl text-white font-bold text-sm cta-glow" style="background:var(--accent)">
        Notify me
      </button>
    </form>
    <p id="form-status-2" aria-live="polite" class="text-xs mt-3 min-h-[18px]" style="color:var(--muted)"></p>
  </div>
</section>

<!-- ── FOOTER ──────────────────────────────────────────────── -->
<footer class="border-t px-6 py-8" style="border-color:rgba(255,255,255,0.06)">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs" style="color:#4a5580">
    <div class="flex items-center gap-2">
      <BrandLogo size={20} alt="" class="w-5 h-5 rounded-md opacity-60" />
      <span>© 2026 health4.ai · Not a medical device</span>
    </div>
    <div class="flex gap-6">
      <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
      <a href="/terms" class="hover:text-white transition-colors">Terms</a>
      <a href="/schema.sql" class="hover:text-white transition-colors">schema.sql</a>
      <a href="https://github.com/jefflitt1/health4ai" target="_blank" rel="noopener" class="hover:text-white transition-colors">GitHub →</a>
    </div>
  </div>
</footer>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the best way to get Apple Health data into Claude Code?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "health4ai is an open-source iOS app and MCP server that syncs HealthKit data to your Postgres database and exposes it to Claude Code, Cursor, and Ollama as native tool calls. It uses HKObserverQuery for reliable background sync and supports Supabase, Neon, and self-hosted Postgres."
      }
    },
    {
      "@type": "Question",
      "name": "Does Claude's native Apple Health integration work with Claude Code?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Anthropic's Apple Health connector is a claude.ai web feature only. It does not reach Claude Code, the API, n8n, or any MCP client outside the browser. health4ai closes this gap with a self-hosted MCP server."
      }
    },
    {
      "@type": "Question",
      "name": "What databases does health4ai support?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "health4ai syncs to any PostgreSQL database. Recommended: Supabase (free tier covers personal use), Neon (serverless Postgres), or any self-hosted Postgres with TLS."
      }
    },
    {
      "@type": "Question",
      "name": "Is health4ai open source?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The iOS app and MCP server are both open source on GitHub at github.com/jefflitt1/health4ai."
      }
    },
    {
      "@type": "Question",
      "name": "Does health4ai store my health data?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Your health data syncs directly to your own database. health4ai never stores, transmits, or has access to your health data."
      }
    },
    {
      "@type": "Question",
      "name": "What Apple Health metrics does health4ai sync?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "health4ai syncs all major HealthKit metrics: steps, heart rate, HRV, sleep stages, workouts, weight, VO2 max, blood oxygen, body temperature, blood pressure, respiratory rate, blood glucose, and all dietary nutrition data."
      }
    }
  ]
}
</script>
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
  // Waitlist submission
  // BUMP THIS whenever the consent label copy changes. consent_source exists to
  // record WHAT a person agreed to; a version that silently goes stale defeats
  // the column. The copy it versions lives on the two <label> elements above.
  const CONSENT_COPY_V = 'v2';

  async function submitWaitlist(email, statusEl, formId, honeypotId, consentId) {
    // Honeypot: bots fill hidden fields, humans don't
    if (document.getElementById(honeypotId)?.value) {
      statusEl.textContent = 'Received — we\'ll be in touch.';
      statusEl.style.color = '#ff6b9d';
      return;
    }
    statusEl.textContent = 'Submitting…';
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/health4ai_waitlist`, {
        method: 'POST',
        headers: {
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=minimal',
        },
        // consent_testflight is recorded per row and gates the invite in the
        // database too. Unticked is a real answer: they still join the list,
        // they just are not handed to Apple.
        body: JSON.stringify({
          email,
          consent_testflight: !!document.getElementById(consentId)?.checked,
          consent_source: `web:${formId}:${CONSENT_COPY_V}`,
        }),
      });
      if (res.ok || res.status === 409) {
        // The 409 branch must not imply the consent landed. anon holds INSERT
        // only, so a repeat submit cannot update consent_testflight on the
        // existing row — the tick is genuinely discarded. Saying "you're already
        // on the list" and nothing else would tell someone who deliberately
        // asked for the beta that everything is fine. Wiring an anon PATCH keyed
        // on email is an enumeration surface and needs Mark Vasquez first.
        const consented = !!document.getElementById(consentId)?.checked;
        statusEl.textContent = res.status === 409
          ? (consented
              ? "You're already on the list. Reply to our launch email to join the beta."
              : "You're already on the list.")
          : "Received — we'll be in touch.";
        statusEl.style.color = '#ff6b9d';
        window.posthog?.capture(
          res.ok ? 'waitlist_signup' : 'waitlist_duplicate',
          { form: formId, testflight_consent: consented }
        );
        // Lock the controls. Leaving the checkbox live after a successful
        // submit lets someone tick it and receive no signal that the tick did
        // nothing.
        if (res.ok) {
          const form = document.getElementById(consentId)?.form;
          form?.querySelectorAll('input, button').forEach((el) => { el.disabled = true; });
        }
      } else {
        window.posthog?.capture('waitlist_error', { form: formId, status: res.status });
        throw new Error(res.status);
      }
    } catch {
      statusEl.textContent = 'Something went wrong. Try again.';
      statusEl.style.color = '#ff5577';
      window.posthog?.capture('waitlist_error', { form: formId, status: 'network_error' });
    }
  }
  // Consider-and-abandon is invisible in waitlist_signup alone.
  ['tf-consent-1', 'tf-consent-2'].forEach((id) => {
    document.getElementById(id)?.addEventListener('change', (e) => {
      window.posthog?.capture('waitlist_consent_toggled', {
        form: id === 'tf-consent-1' ? 'hero' : 'bottom',
        checked: e.target.checked,
      });
    });
  });

  document.getElementById('waitlist-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    await submitWaitlist(document.getElementById('email-input').value, document.getElementById('form-status'), 'hero', 'hp-1', 'tf-consent-1');
  });
  document.getElementById('waitlist-form-2')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    await submitWaitlist(document.getElementById('email-input-2').value, document.getElementById('form-status-2'), 'bottom', 'hp-2', 'tf-consent-2');
  });

  // Backend tabs
  document.getElementById('backend-tabs')?.addEventListener('click', (e) => {
    const btn = e.target.closest('.tab-btn');
    if (!btn) return;
    const tab = btn.dataset.tab;
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b === btn));
    document.querySelectorAll('.backend-content').forEach(c => {
      c.hidden = c.id !== `tab-${tab}`;
    });
  });
</script>
