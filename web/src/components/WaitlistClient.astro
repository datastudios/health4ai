---
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
  // Waitlist submission
  // BUMP THIS whenever the consent label copy changes. consent_source exists to
  // record WHAT a person agreed to; a version that silently goes stale defeats
  // the column. The copy it versions lives on the two <label> elements above.
  const CONSENT_COPY_V = 'v3';

  function showWaitlistNext(nextId, isDuplicate) {
    const nextEl = document.getElementById(nextId);
    if (!nextEl) return;
    const title = nextEl.querySelector('.wl-next-title');
    if (title) {
      title.textContent = isDuplicate ? 'While you wait' : "You're on the list — next steps";
    }
    nextEl.hidden = false;
    // Hide the always-on explore row for this form cluster to avoid duplicate CTAs.
    const explore = nextEl.parentElement?.querySelector('.wl-explore');
    if (explore) explore.hidden = true;
  }

  async function submitWaitlist(email, statusEl, formId, honeypotId, consentId, nextId) {
    // Honeypot: bots fill hidden fields, humans don't
    if (document.getElementById(honeypotId)?.value) {
      statusEl.textContent = 'Received — we\'ll be in touch.';
      statusEl.style.color = '#ff6b9d';
      return;
    }
    statusEl.textContent = 'Submitting…';
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/health4ai_waitlist`, {
        method: 'POST',
        headers: {
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=minimal',
        },
        // consent_testflight is recorded per row and gates the invite in the
        // database too. Unticked is a real answer: they still join the list,
        // they just are not handed to Apple.
        body: JSON.stringify({
          email,
          consent_testflight: !!document.getElementById(consentId)?.checked,
          consent_source: `web:${formId}:${CONSENT_COPY_V}`,
        }),
      });
      if (res.ok || res.status === 409) {
        // The 409 branch must not imply the consent landed. anon holds INSERT
        // only, so a repeat submit cannot update consent_testflight on the
        // existing row — the tick is genuinely discarded. Saying "you're already
        // on the list" and nothing else would tell someone who deliberately
        // asked for the beta that everything is fine. Wiring an anon PATCH keyed
        // on email is an enumeration surface and needs Mark Vasquez first.
        const consented = !!document.getElementById(consentId)?.checked;
        statusEl.textContent = res.status === 409
          ? (consented
              ? "You're already on the list. Reply to our launch email to join the beta."
              : "You're already on the list.")
          : "Received — we'll be in touch.";
        statusEl.style.color = '#ff6b9d';
        showWaitlistNext(nextId, res.status === 409);
        window.posthog?.capture(
          res.ok ? 'waitlist_signup' : 'waitlist_duplicate',
          { form: formId, testflight_consent: consented }
        );
        // Lock the controls. Leaving the checkbox live after a successful
        // submit lets someone tick it and receive no signal that the tick did
        // nothing.
        if (res.ok) {
          const form = document.getElementById(consentId)?.form;
          form?.querySelectorAll('input, button').forEach((el) => { el.disabled = true; });
        }
      } else {
        window.posthog?.capture('waitlist_error', { form: formId, status: res.status });
        throw new Error(res.status);
      }
    } catch {
      statusEl.textContent = 'Something went wrong. Try again.';
      statusEl.style.color = '#ff5577';
      window.posthog?.capture('waitlist_error', { form: formId, status: 'network_error' });
    }
  }
  // Consider-and-abandon is invisible in waitlist_signup alone.
  ['tf-consent-1', 'tf-consent-2'].forEach((id) => {
    document.getElementById(id)?.addEventListener('change', (e) => {
      window.posthog?.capture('waitlist_consent_toggled', {
        form: id === 'tf-consent-1' ? 'hero' : 'bottom',
        checked: e.target.checked,
      });
    });
  });

  document.getElementById('waitlist-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    await submitWaitlist(document.getElementById('email-input').value, document.getElementById('form-status'), 'hero', 'hp-1', 'tf-consent-1', 'waitlist-next-1');
  });
  document.getElementById('waitlist-form-2')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    await submitWaitlist(document.getElementById('email-input-2').value, document.getElementById('form-status-2'), 'bottom', 'hp-2', 'tf-consent-2', 'waitlist-next-2');
  });

</script>
