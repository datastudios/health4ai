# health4ai MCP server — environment variables
# Copy to .env and fill in your values. The server reads exactly the variables listed here.

# ── Database connection (required) ─────────────────────────────────────────────
# The Postgres connection string of YOUR Supabase project — use the Transaction pooler
# string (port 6543) from the project's database connection settings.
#
# The password in it is your DATABASE PASSWORD (chosen when you created the project, and
# resettable in the project's database settings). It is NOT the service_role key and NOT
# the anon key. An earlier version of this file told you to paste the service_role key as
# the password: that connection simply fails, and it put your most privileged key in a file.
DATABASE_URL=postgresql://postgres.<project_ref>:<database_password>@<pooler_host>:6543/postgres

# SUPABASE_DB_URL is accepted as an alias when DATABASE_URL is unset. Nothing is
# auto-built from SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY — set one of these two.
# SUPABASE_DB_URL=

# Seconds to wait for the database before giving up (default 5).
# DB_CONNECT_TIMEOUT=5

# ── Whose data (required) ──────────────────────────────────────────────────────
# The UUID of the Supabase Auth user you sign in with in the iOS app: in your project's
# Authentication → Users list, copy that user's UID. It must be that exact UUID. The app
# writes every row under it and the column is a uuid, so an email address or username
# will not match anything.
HEALTHKIT_USER_ID=00000000-0000-0000-0000-000000000000
# The server refuses to start while this is unset, not a UUID, or still the placeholder above.

# ── Time zone (optional, default UTC) ──────────────────────────────────────────
# IANA name. Day boundaries follow it: daily totals, snapshots, trends and sleep nights
# are bucketed in this zone, so set it to the zone you live in. Invalid names fail at startup.
# HEALTH4AI_TZ=America/New_York

# The server is stdio-only. The former HTTP transport and its MCP_AUTH_ENABLED /
# MCP_BIND_HOST variables were removed; set neither.
